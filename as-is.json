{
  "configuration": {
    "records": { "filenames": { "backlog": "backlog.md", "changelog": "changelog.md", "task": "tasks.md" } },
    "tasks": { "unitBudget": { "wallClockSeconds": 300, "costUsd": 0.5 } },
    "scheduling": { "wakeSeconds": 60, "checkInSeconds": 300, "maxConcurrentTasks": 1, "retryBackoffSeconds": 300, "maxRecoveryAttempts": 2 },
    "notifications": { "materialEvents": true },
    "agents": {
      "defaultRole": "as-is",
      "defaultModel": "small",
      "provider": "openrouter",
      "models": { "small": "@preset/abs-small", "medium": "@preset/abs-medium", "large": "@preset/abs-large", "xlarge": "@preset/abs-xlarge" }
    },
    "technology-preferences": { "runtime": "bun", "package-manager": "bun" },
    "hitl": { "onBlocked": true, "onBudgetExceeded": true, "onExternalEffect": true },
    "logging": { "level": "info", "retainDays": 30 },
    "observability": { "tracing": { "backend": "file", "enabled": true, "local-directory": ".as-is/tracing.jsonl" } }
  },
  "task": {
    "status": "active",
    "worker": "as-is",
    "updated": "2026-08-15T21:18:00Z",
    "constraints": {
      "cost": { "currency": "USD", "allocated": 0.5, "spent": 0, "reserve": 0.1, "source": "unavailable", "fallback-metric": "validation elapsed-seconds" },
      "delegation": { "maximum-depth": 0, "maximum-children": 0 },
      "execution": { "wall-clock": { "allocated-seconds": 300, "spent-seconds": 0, "reserve-seconds": 60, "source": "unavailable" } },
      "external-effects": "prohibited"
    },
    "acceptance": [
      "The current launcher regression fixture's thinking-level expectation matches the repository's configured medium declarations.",
      "The late-success budget fixture uses valid shell newlines and proves budget-stop escalation without timing out.",
      "The caller-worktree ancestry fixture reflects cherry-pick semantics by validating the new integrated commit rather than the original child SHA.",
      "Focused regression tests and task/content/JSON/whitespace checks pass; no launcher production behavior or task authority changes are included."
    ]
  }
}
