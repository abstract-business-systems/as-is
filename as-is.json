{
  "configuration": {
    "records": {
      "filenames": {
        "backlog": "backlog.md",
        "changelog": "changelog.md",
        "task": "tasks.md"
      }
    },
    "tasks": {
      "unitBudget": {
        "wallClockSeconds": 300,
        "costUsd": 0.5
      }
    },
    "scheduling": {
      "wakeSeconds": 60,
      "checkInSeconds": 300,
      "maxConcurrentTasks": 1,
      "retryBackoffSeconds": 300,
      "maxRecoveryAttempts": 2
    },
    "notifications": {
      "materialEvents": true
    },
    "agents": {
      "defaultRole": "as-is",
      "defaultModel": "small",
      "provider": "openrouter",
      "models": {
        "small": "@preset/abs-small",
        "medium": "@preset/abs-medium",
        "large": "@preset/abs-large",
        "xlarge": "@preset/abs-xlarge"
      }
    },
    "technology-preferences": {
      "runtime": "bun",
      "package-manager": "bun"
    },
    "hitl": {
      "onBlocked": true,
      "onBudgetExceeded": true,
      "onExternalEffect": true
    },
    "logging": {
      "level": "info",
      "retainDays": 30
    },
    "observability": {
      "tracing": {
        "backend": "file",
        "enabled": true,
        "local-directory": ".as-is/tracing.jsonl"
      }
    }
  },
  "task": {
    "status": "active",
    "worker": "as-is",
    "updated": "2026-08-15T23:45:00Z",
    "constraints": {
      "cost": {
        "currency": "USD",
        "allocated": 0.3,
        "spent": 0,
        "reserve": 0.05,
        "source": "unavailable",
        "fallback-metric": "validation elapsed-seconds"
      },
      "delegation": {
        "maximum-depth": 0,
        "maximum-children": 0
      },
      "execution": {
        "wall-clock": {
          "allocated-seconds": 360,
          "spent-seconds": 0,
          "reserve-seconds": 60,
          "source": "unavailable"
        }
      },
      "external-effects": "prohibited"
    },
    "acceptance": [
      "Define a two-commit completion flow: first commit records selected backlog status and creates the active task artifacts; second commit records changelog completion, removes the exact backlog row, and deletes the paired task artifacts.",
      "Update relevant skills and authoritative lifecycle records without changing task authority, schema, or runtime behavior.",
      "Validate, obtain review, and leave a clean worktree after the second commit."
    ]
  }
}
