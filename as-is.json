{
  "configuration": {
    "records": {
      "filenames": {
        "backlog": "backlog.md",
        "changelog": "changelog.md",
        "task": "tasks.md"
      }
    },
    "tasks": {
      "unitBudget": {
        "wallClockSeconds": 420,
        "costUsd": 0.7
      }
    },
    "scheduling": {
      "wakeSeconds": 60,
      "checkInSeconds": 300,
      "maxConcurrentTasks": 1,
      "retryBackoffSeconds": 300,
      "maxRecoveryAttempts": 2
    },
    "notifications": {
      "materialEvents": true
    },
    "agents": {
      "defaultRole": "as-is",
      "defaultModel": "small",
      "provider": "openrouter",
      "models": {
        "small": "@preset/abs-small",
        "medium": "@preset/abs-medium",
        "large": "@preset/abs-large",
        "xlarge": "@preset/abs-xlarge"
      }
    },
    "technology-preferences": {
      "runtime": "bun",
      "package-manager": "bun"
    },
    "hitl": {
      "onBlocked": true,
      "onBudgetExceeded": true,
      "onExternalEffect": true
    },
    "logging": {
      "level": "info",
      "retainDays": 30
    },
    "observability": {
      "tracing": {
        "backend": "file",
        "enabled": true,
        "local-directory": ".as-is/tracing.jsonl"
      }
    }
  },
  "task": {
    "status": "ready",
    "worker": "as-is",
    "updated": "2026-08-15T20:58:00Z",
    "constraints": {
      "cost": {
        "currency": "USD",
        "allocated": 0.7,
        "spent": 0,
        "reserve": 0.14,
        "source": "unavailable",
        "fallback-metric": "validation elapsed-seconds"
      },
      "delegation": {
        "maximum-depth": 0,
        "maximum-children": 0
      },
      "execution": {
        "wall-clock": {
          "allocated-seconds": 420,
          "spent-seconds": 0,
          "reserve-seconds": 84,
          "source": "unavailable"
        }
      },
      "external-effects": "prohibited"
    },
    "acceptance": [
      "The launcher has one explicit compatible Pi version contract derived from the skill-owned package and uses it for package fallback and extension compatibility checks.",
      "Explicit local Pi binaries, skill-local binaries, and package-runner fallback are version-checked before a child starts; mismatched or unreportable versions fail closed with bounded diagnostics.",
      "Focused tests cover matching, mismatched, unavailable, malformed, and package-fallback version observations without starting a child or contacting a provider.",
      "Durable skill records and changelog evidence describe the version contract, residual host limitations, and recovery; no extension relocation, setup, host integration, task-authority, or broad runtime change is included."
    ]
  }
}
