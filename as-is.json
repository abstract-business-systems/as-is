{
  "configuration": {
    "records": {
      "filenames": {
        "backlog": "backlog.md",
        "changelog": "changelog.md",
        "task": "tasks.md"
      }
    },
    "tasks": {
      "unitBudget": {
        "wallClockSeconds": 300,
        "costUsd": 0.5
      }
    },
    "scheduling": {
      "wakeSeconds": 60,
      "checkInSeconds": 300,
      "maxConcurrentTasks": 1,
      "retryBackoffSeconds": 300,
      "maxRecoveryAttempts": 2
    },
    "notifications": {
      "materialEvents": true
    },
    "dirs": {
      "project-temp": ".as-is"
    },
    "agents": {
      "defaultRole": "as-is",
      "defaultModel": "small",
      "provider": "openrouter",
      "sessionDirectory": ".as-is/subagents/sessions",
      "models": {
        "small": "@preset/abs-small",
        "medium": "@preset/abs-medium",
        "large": "@preset/abs-large",
        "xlarge": "@preset/abs-xlarge"
      }
    },
    "technology-preferences": {
      "runtime": "bun",
      "package-manager": "bun"
    },
    "hitl": {
      "onBlocked": true,
      "onBudgetExceeded": true,
      "onExternalEffect": true
    },
    "logging": {
      "level": "info",
      "retainDays": 30
    },
    "observability": {
      "tracing": {
        "backend": "file",
        "enabled": true,
        "local-directory": ".as-is/tracing.jsonl"
      }
    },
    "security": {
      "emitted-paths": "masked-runtime-references"
    }
  },
  "task": {
    "status": "cancelled",
    "worker": "as-is",
    "updated": "2026-08-29T15:19:09Z",
    "constraints": {
      "cost": {
        "currency": "USD",
        "allocated": 1,
        "spent": 0,
        "reserve": 0.1,
        "source": "unavailable",
        "fallback-metric": "validation elapsed-seconds"
      },
      "delegation": {
        "maximum-depth": 3,
        "maximum-children": 2
      },
      "execution": {
        "wall-clock": {
          "allocated-seconds": 900,
          "spent-seconds": 0,
          "reserve-seconds": 120,
          "source": "unavailable"
        }
      },
      "external-effects": "require-current-turn-user-approval"
    },
    "acceptance": [
      "Preserve the accepted Draft-6 envelope and prepare only the exact root → core → core/modules → core/modules/task-control task hierarchy.",
      "Record each child allocation, dependency, protected-input, worker, acceptance, recovery, and stop condition without authorizing implementation.",
      "Obtain current task-control admission evidence for every prepared task before any worker launch.",
      "Keep process-adapter integration, fixture candidate-flow exercise, benchmarking, migration, adoption, retirement, commit, and merge outside this task."
    ]
  }
}
