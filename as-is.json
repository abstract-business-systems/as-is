{
  "configuration": {
    "records": {
      "filenames": {
        "backlog": "backlog.md",
        "changelog": "changelog.md",
        "task": "tasks.md"
      }
    },
    "tasks": {
      "unitBudget": {
        "wallClockSeconds": 300,
        "costUsd": 0.5
      }
    },
    "scheduling": {
      "wakeSeconds": 60,
      "checkInSeconds": 300,
      "maxConcurrentTasks": 1,
      "retryBackoffSeconds": 300,
      "maxRecoveryAttempts": 2
    },
    "notifications": {
      "materialEvents": true
    },
    "agents": {
      "defaultRole": "as-is",
      "defaultModel": "small",
      "provider": "openrouter",
      "models": {
        "small": "@preset/abs-small",
        "medium": "@preset/abs-medium",
        "large": "@preset/abs-large",
        "xlarge": "@preset/abs-xlarge"
      }
    },
    "technology-preferences": {
      "runtime": "bun",
      "package-manager": "bun"
    },
    "hitl": {
      "onBlocked": true,
      "onBudgetExceeded": true,
      "onExternalEffect": true
    },
    "logging": {
      "level": "info",
      "retainDays": 30
    },
    "observability": {
      "tracing": {
        "backend": "file",
        "enabled": true,
        "local-directory": ".as-is/tracing.jsonl"
      }
    },
    "security": {
      "emitted-paths": "masked-runtime-references"
    }
  },
  "task": {
    "status": "completed",
    "worker": "component-builder",
    "updated": "2026-08-16T18:05:00Z",
    "constraints": {
      "cost": {
        "currency": "USD",
        "allocated": 0.5,
        "spent": 0,
        "reserve": 0.1,
        "source": "unavailable",
        "fallback-metric": "validation elapsed-seconds"
      },
      "delegation": {
        "maximum-depth": 0,
        "maximum-children": 0
      },
      "execution": {
        "wall-clock": {
          "allocated-seconds": 300,
          "spent-seconds": 0,
          "reserve-seconds": 60,
          "source": "unavailable"
        }
      },
      "external-effects": "prohibited"
    },
    "acceptance": [
      "The execution-contract readiness inventory reconciles conceptual lifecycle vocabulary with current task-control, process-adapter, launcher, observability, budget, and Git/worktree consumers without creating a speculative execution-contract module.",
      "Provider-free fixtures cover launch admission, accepted launch observation, failure, cancellation or bounded recovery, stale-revision rejection, and unavailable-host evidence.",
      "The resulting observation seam, or documented decision not to create one, preserves task-control as durable authority and does not split lifecycle ownership or change runtime behavior.",
      "Task-record, focused behavioral, content/navigation, backlog, JSON, reference, diagnostics, whitespace, and final review validation pass."
    ]
  }
}
