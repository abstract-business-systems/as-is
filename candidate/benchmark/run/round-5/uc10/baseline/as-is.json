{
  "configuration": {
    "records": {
      "filenames": {
        "backlog": "backlog.md",
        "changelog": "changelog.md",
        "task": "tasks.md"
      }
    },
    "tasks": {
      "unitBudget": {
        "wallClockSeconds": 300,
        "costUsd": 0.5
      }
    },
    "scheduling": {
      "wakeSeconds": 60,
      "checkInSeconds": 300,
      "maxConcurrentTasks": 1,
      "retryBackoffSeconds": 300,
      "maxRecoveryAttempts": 2
    },
    "dirs": {
      "project-temp": ".as-is"
    },
    "agents": {
      "defaultRole": "as-is",
      "defaultModel": "z-ai/glm-5.3-flash",
      "provider": "openrouter",
      "sessionDirectory": ".as-is/subagents/sessions",
      "models": {
        "glm-5.3-flash": "z-ai/glm-5.3-flash"
      }
    },
    "technology-preferences": {
      "runtime": "bun",
      "package-manager": "bun"
    }
  }
}
