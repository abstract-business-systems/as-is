qual(count_words(\"Apple! apple, BANANA.\"), {\"apple\": 2, \"banana\": 1})\n\n    def test_ignores_punctuation_only_tokens(self):\n        self.assertEqual(count_words(\"-- ...\"), {})\n\n    def test_empty_input(self):\n        self.assertEqual(count_words(\"\"), {})\n\n\nif __name__ == \"__main__\":\n    unittest.main()\nthe quick brown fox\nthe lazy dog\nthe fox\n"}],"details":{}}}
